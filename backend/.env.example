APP_ENV=dev
APP_NAME=GitAnalyzer Pro
LOG_LEVEL=INFO

# Required for private repositories
GITHUB_TOKEN=

# AI providers (set one or both)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_PROVIDER=openai

# PlantUML server base URL (must end with /plantuml)
PLANTUML_BASE_URL=https://www.plantuml.com/plantuml

# CORS
FRONTEND_ORIGIN=http://localhost:5173
